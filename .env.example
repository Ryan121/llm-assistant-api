# =============================================================================
# llm-assistant-api -- single source of truth for the whole deployment
#
#   cp .env.example .env    (or just run `make quickstart`, which does it)
#
# Consumed by: docker-compose.yml, the FastAPI gateway, and -- via
# scripts/env-to-tfvars.sh -- Terraform and Ansible.
# =============================================================================

# -----------------------------------------------------------------------------
# MODEL
# -----------------------------------------------------------------------------
# Pulled from Hugging Face on first start into the MODEL_CACHE_VOLUME. Nothing
# is baked into any image. See docs/MODEL_SELECTION.md for the shortlist and
# the VRAM arithmetic behind these defaults.
#
# Default: Qwen3-Coder-30B-A3B-Instruct -- MoE, 30B total / 3B active.
#   BF16 weights ~61 GB -> ~31 GB per card at TP=2 on 2x RTX A6000 (2x 48 GB),
#   leaving ~15 GB per card for the KV cache. Ampere has no native FP8, so
#   BF16 is the right dtype here.
MODEL_ID=Qwen/Qwen3-Coder-30B-A3B-Instruct

# Only needed for gated repos (Llama, some Mistral). Qwen is ungated.
HF_TOKEN=

# -----------------------------------------------------------------------------
# GPU / vLLM SERVING
# -----------------------------------------------------------------------------
VLLM_IMAGE=vllm/vllm-openai:v0.11.0
CUDA_VISIBLE_DEVICES=0,1

# How the model is split. TENSOR_PARALLEL_SIZE x PIPELINE_PARALLEL_SIZE must
# not exceed your GPU count.
#
#   TP=2, PP=1  Default. Splits every layer across both cards. Lowest latency,
#               but it all-reduces once per layer -- so it needs a fast, and
#               above all *reliable*, link between the GPUs.
#   TP=1, PP=2  Splits by layer instead. Passes activations point-to-point at
#               the boundary, a few hundred KB per token rather than an
#               all-reduce per layer. Slightly higher latency, far more
#               tolerant of a slow or flaky interconnect. Use this if
#               `nvidia-smi topo -m` shows PHB/SYS, or on a VM with
#               passed-through GPUs. See MULTI-GPU STABILITY below.
TENSOR_PARALLEL_SIZE=2
PIPELINE_PARALLEL_SIZE=1

MAX_MODEL_LEN=131072
GPU_MEMORY_UTILIZATION=0.80
VLLM_DTYPE=bfloat16
VLLM_MAX_NUM_SEQS=32

# Agentic coding needs tool calling. The parser must match the model family:
#   Qwen3-Coder ....... qwen3_coder
#   Qwen3 / Qwen2.5 ... hermes
#   Devstral / Mistral  mistral   (add --tokenizer-mode mistral to EXTRA_ARGS)
#   GLM-4.5 ........... glm45
# Blank this out entirely to serve without server-side tool parsing.
VLLM_TOOL_ARGS=--enable-auto-tool-choice --tool-call-parser qwen3_coder

# Anything else you want to hand to vLLM verbatim, e.g.
#   --quantization awq_marlin  --rope-scaling '{...}'  --enforce-eager
VLLM_EXTRA_ARGS=--enable-prefix-caching --disable-log-requests

# -----------------------------------------------------------------------------
# MULTI-GPU STABILITY
#
# Symptom this section exists for: the server loads and answers for a while,
# then dies mid-generation with
#     TimeoutError: RPC call to execute_model timed out
#     vllm.v1.engine.exceptions.EngineDeadError
# on a single-token decode step with the KV cache nearly empty. That is a GPU
# or interconnect hang, not load.
#
# First, establish which world you are in:
#     nvidia-smi topo -m                     # NV# = NVLink; PHB/PXB/SYS = PCIe
#     nvidia-smi nvlink -s                   # "inActive" = no bridge fitted
#     sudo dmesg -T | grep -iE 'xid|nvrm'    # Xid 48/62/79/94/95 = hardware, stop
#                                            # Xid 13/31/43 = software fault, read on
#
# NO NVLINK (PHB/PXB/SYS), OR GPUs PASSED THROUGH TO A VM
#
# vLLM enables its own all-reduce kernel by default for TP<=8, and it needs
# working peer-to-peer. Critically, VLLM_SKIP_P2P_CHECK defaults to "1", which
# means vLLM does NOT verify that P2P works -- it trusts the driver's report.
# On a hypervisor the driver reports P2P available while the ACS required for
# per-device IOMMU groups forces device-to-device DMA up through the root
# complex, so the kernel is enabled over a path that does not work.
#
# Set ALL THREE. They are not redundant: NCCL_P2P_DISABLE only affects NCCL,
# and vLLM's custom all-reduce uses CUDA IPC directly, so disabling P2P for
# NCCL alone leaves the broken path in use.
#
#     NCCL_P2P_DISABLE=1
#     VLLM_SKIP_P2P_CHECK=0
#     VLLM_EXTRA_ARGS=<existing flags> --disable-custom-all-reduce
#
# There is no VLLM_DISABLE_CUSTOM_ALL_REDUCE env var; the CLI flag is the only
# unconditional way to turn the kernel off. Collectives then stage through host
# memory: slower per all-reduce, but correct. Costs roughly 10-30% decode
# latency at batch 1, since a TP=2 all-reduce here is latency-bound rather
# than bandwidth-bound.
#
# Confirm the change actually reached the engine -- editing .env is not the
# same as restarting the server:
#     make show-config       # must report disable_custom_all_reduce=True
NCCL_P2P_DISABLE=0
VLLM_SKIP_P2P_CHECK=1
#
# STILL HANGING
#
# 1. Take the interconnect out of the hot path: TENSOR_PARALLEL_SIZE=1 with
#    PIPELINE_PARALLEL_SIZE=2. Pipeline parallelism sends activations
#    point-to-point at one layer boundary instead of all-reducing at every
#    layer, so there is far less to go wrong.
# 2. Avoid multi-GPU entirely: run an AWQ/GPTQ INT4 build of the model on one
#    card (TP=1, PP=1) with --quantization awq_marlin. A 30B INT4 checkpoint
#    is ~17 GB, so it fits one A6000 with room for a large KV cache, and no
#    collective is ever issued. INT4 on Ampere uses the Marlin kernels and is
#    fast; this is the most robust option on a bad interconnect.
# 3. Add --enforce-eager to rule out a CUDA-graph replay hang. Costs 10-20%
#    decode throughput -- use it to isolate a cause, not as a permanent setting.
#
# WARN logs the NCCL side of a failure; INFO is very noisy but shows which
# collective stalled.
NCCL_DEBUG=WARN

# Seconds Docker allows for the very first start (model download + load).
VLLM_START_PERIOD=3600s

# -----------------------------------------------------------------------------
# OPTIONAL: second small model for inline fill-in-the-middle autocomplete.
# Costs ~4 GB of VRAM and makes tab-completion feel instant. Enable with:
#   AUTOCOMPLETE_ENABLED=true  and  make up PROFILES="--profile autocomplete"
# -----------------------------------------------------------------------------
AUTOCOMPLETE_ENABLED=false
AUTOCOMPLETE_MODEL_ID=Qwen/Qwen2.5-Coder-1.5B
AUTOCOMPLETE_MAX_MODEL_LEN=8192
AUTOCOMPLETE_GPU_MEMORY_UTILIZATION=0.08

# -----------------------------------------------------------------------------
# GATEWAY (FastAPI)
# -----------------------------------------------------------------------------
API_PORT=8081
API_IMAGE=ghcr.io/ryan121/llm-assistant-api
# `local` is what `make build` produces. CI publishes semver tags (1.4.2).
API_IMAGE_TAG=local
LOG_LEVEL=INFO
WEB_CONCURRENCY=2

# Comma-separated bearer tokens accepted by the gateway. LEAVE EMPTY AND THE
# GATEWAY IS OPEN to anything that can reach API_PORT. `make quickstart`
# generates one for you if this is still blank.
API_KEYS=

# Token vLLM itself requires (defence in depth on a shared host). Optional.
UPSTREAM_API_KEY=

# 0 = no ceiling. Set e.g. 8192 to stop one runaway agent loop from pinning a
# KV-cache slot for minutes.
MAX_TOKENS_CAP=0

# Accept any model name from the editor and serve MODEL_ID anyway. Keep true --
# it is what makes hard-coded plugin model names work.
MODEL_ALIAS_FALLBACK=true

# Repair tool-call arguments on inbound requests. The OpenAI schema says
# `tool_calls[].function.arguments` is a JSON *string*; vLLM enforces that with
# json.loads and returns 400 otherwise, where most servers are lenient. Editor
# extensions replaying conversation history commonly send a Python dict repr
# ({'path': 'a.py'}), an already-decoded object, or "" for a no-argument call --
# all three become:
#     JSONDecodeError: Expecting property name enclosed in double quotes
# Every repair is logged, and valid JSON is passed through untouched, so this
# can only turn a failing request into a working one. Turn it off to see the
# raw client behaviour when debugging an extension.
NORMALIZE_TOOL_ARGUMENTS=true

# Report vLLM's own /v1/models list instead of the configured one.
EXPOSE_UPSTREAM_MODELS=false

# Browser origins allowed to call the gateway. Empty = none (CORS disabled).
# VS Code extensions do not need this; only web UIs do.
CORS_ORIGINS=

REQUEST_TIMEOUT_SECONDS=900

# -----------------------------------------------------------------------------
# DOCKER RESOURCES (owned by Terraform, referenced as external by Compose)
# -----------------------------------------------------------------------------
DOCKER_NETWORK=llm-assistant-net
MODEL_CACHE_VOLUME=llm-assistant-model-cache
